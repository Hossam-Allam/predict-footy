<%= render "shared/header" %>


<%= turbo_frame_tag "leagues_frame" do %>
  <h1 class="Lindex-title">My Leagues</h1>
  <div class="league-actions">
    <details class="league-dropdown">
      <summary class="league-dropdown-toggle">+ League</summary>

      <div class="league-dropdown-panel">
        <input type="radio" name="league-tab" id="tab-create" class="league-tab-input" checked>
        <input type="radio" name="league-tab" id="tab-join" class="league-tab-input">

        <div class="league-tabs">
          <label for="tab-create" class="league-tab-label">Create League</label>
          <label for="tab-join" class="league-tab-label">Join League</label>
        </div>

        <div class="league-tab-panel league-tab-panel--create">
          <%= render "form", league: League.new %>
        </div>

        <div class="league-tab-panel league-tab-panel--join">
          <%= render "join_form" %>
        </div>
      </div>
    </details>
  </div>
  <div class="leagues-container">
    <% unless @leagues.empty? %>
      <div class="league-header">
        <div class="league-name"><strong>League Name</strong></div>
        <div class="league-points"><strong>Points</strong></div>
        <div class="league-members"><strong>Rank</strong></div>
      </div>

      <% @leagues.each do |league| %>
        <div class="league">
          <div class="league-name">
            <%= link_to league.name, my_league_path(league) %>
          </div>
          
          <div class="league-points">
            <% if (membership = @memberships_by_league[league.id]) %>
              <%= membership.points %> <% end %>
          </div>

          <div class="league-members">
            <% if (rank = @ranks_by_league[league.id]) %>
              <%= rank %> <% else %>
              —
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>